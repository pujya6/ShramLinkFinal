# Copy to .env only for your own local configuration. Never commit .env.
SHRAMLINK_ENV=development
# Leave empty for a generated, persistent local development key.
# Production requires a new random key of at least 32 characters.
SECRET_KEY=
# Default: instance/shramlink.sqlite3. Use an ABSOLUTE path for existing databases.
# DATABASE_URL=sqlite:////absolute/path/to/private/shramlink.sqlite3
HOST=127.0.0.1
PORT=5000

# One application, four configurations. Defaults need no external services.
VOICE_PROVIDER=deterministic
JOB_SOURCE=demo
SHRAMLINK_DEMO=true
# Optional server-side interpretation; never put these in JavaScript.
XAI_API_KEY=
# Set to grok-4.3 only after checking provider availability and billing.
XAI_MODEL=
XAI_DAILY_REQUEST_LIMIT=60
XAI_USER_DAILY_LIMIT=30
# Optional prices for the admin estimate. 0 means unknown, not free.
XAI_INPUT_USD_PER_MILLION=0
XAI_OUTPUT_USD_PER_MILLION=0
# Public Greenhouse board token and its actual employer name; not a URL.
GREENHOUSE_BOARD=
GREENHOUSE_EMPLOYER=
# Operator must explicitly review/attest the board's category before enabling.
# This does not make any job or identity verified.
GREENHOUSE_FORMAL_ATTESTED=false
